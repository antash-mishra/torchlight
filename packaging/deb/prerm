#!/bin/sh
# Stop the per-user search daemon of every logged-in user when the package is removed.
# Upgrades keep it running; postinst restarts it onto the new version.
set -e

if [ "$1" = remove ] && command -v systemctl >/dev/null 2>&1; then
    for uid in $(systemctl --no-legend --quiet list-units 'user@*' 2>/dev/null |
                 sed -n -r 's/.*user@([0-9]+)\.service.*/\1/p'); do
        systemctl --quiet --user --machine "$uid@" stop torchlightd.service 2>/dev/null || true
    done
fi

exit 0
